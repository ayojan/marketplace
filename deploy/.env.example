# ==============================================================================
# Jashnify / Ayoj Production Environment Variables
# Location on GCP VM: /opt/ayoj-backend/.env
# NOTE: Never commit the live .env file to Git!
# ==============================================================================

# Reverse Proxy & Domain Configuration
DOMAIN=api.ayoj.in
DOCKER_IMAGE=ghcr.io/jashni-fy/marketplace-backend:latest

# Rails Core Settings
RAILS_ENV=production
RAILS_MAX_THREADS=3
WEB_CONCURRENCY=0
SOLID_QUEUE_IN_PUMA=true
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_LEVEL=info
PORT=3000

# Secrets (Generate with: openssl rand -hex 64)
SECRET_KEY_BASE=replace_with_openssl_rand_hex_64
JWT_SECRET_KEY=replace_with_openssl_rand_hex_64
DEVISE_SECRET_KEY=replace_with_openssl_rand_hex_64

# PostgreSQL Database (Supabase pooler URI with sslmode=require)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Cloudflare R2 Object Storage (10 GB free tier, unlimited $0 egress)
CLOUDFLARE_R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
CLOUDFLARE_R2_BUCKET=ayoj-media
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
MAILER_FROM_EMAIL=notifications@ayoj.in

# Frontend URL & CORS Allowed Origins
FRONTEND_URL=https://ayoj.in
ALLOWED_ORIGINS=https://ayoj.in,https://admin.ayoj.in,https://www.ayoj.in

# Database Auto-Migration on boot (set to false to skip db:prepare)
AUTO_MIGRATE=true
