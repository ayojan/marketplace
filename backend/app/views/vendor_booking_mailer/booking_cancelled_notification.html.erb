<h2>Booking Cancelled</h2>

<p>Hello <%= @vendor.business_name %>,</p>

<p>The booking with <strong><%= @customer.user.name %></strong> for <strong><%= @service.name %></strong> has been cancelled.</p>

<div class="details-card">
  <h3>Booking Information</h3>
  <ul class="details-list">
    <li><strong>Client:</strong> <%= @customer.user.name %></li>
    <li><strong>Service:</strong> <%= @service.name %></li>
    <li><strong>Original Date:</strong> <%= format_booking_time(@booking) %></li>
    <li><strong>Location:</strong> <%= @booking.event_location %></li>
    <li><strong>Status:</strong> Cancelled</li>
  </ul>
</div>

<div class="button-container">
  <a href="<%= @view_booking_url %>" class="button">View Schedule</a>
</div>

<p style="margin-top: 24px;">Your calendar slot has been freed and can now accept other bookings for this date.</p>

<p>Best regards,<br>
<strong>The Ayoj Team</strong></p>
