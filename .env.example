# ==============================================================================
# Ayoj Unified Environment Variables Reference (.env.example)
#
# USAGE:
# 1. Local Development (Docker Compose):
#    Default values are already wired in docker-compose.local.yml.
#    You don't need a .env file locally unless customizing credentials.
#
# 2. Production Deployment (OCI / GitHub Actions):
#    Copy the contents of this file into your GitHub Repository Secret
#    named `ENV_PRODUCTION`. GitHub Actions will automatically deploy it
#    to ~/.env.production on your OCI server.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Container Images (GHCR - Production)
# ------------------------------------------------------------------------------
BACKEND_IMAGE=ghcr.io/ajeet/marketplace-backend:latest
FRONTEND_IMAGE=ghcr.io/ajeet/marketplace-frontend:latest

# ------------------------------------------------------------------------------
# 2. PostgreSQL Configuration
# ------------------------------------------------------------------------------
# Local dev default:   POSTGRES_DB=marketplace_development, POSTGRES_PASSWORD=password
# Production default:  POSTGRES_DB=marketplace_production,  POSTGRES_PASSWORD=<secure-hex-32>
POSTGRES_DB=marketplace_production
POSTGRES_USER=marketplace
DATABASE_PASSWORD=your_secure_postgres_password_here

# ------------------------------------------------------------------------------
# 3. Rails Core Secrets & Performance Tuning
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=your_generated_secret_key_base_here

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your_generated_jwt_secret_key_here

RAILS_ENV=production
RAILS_LOG_LEVEL=info

# Puma Concurrency (2 workers x 5 threads = 10 concurrent requests for 2 OCPUs)
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5

# Redis Caching & Background Queues
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. Active Storage with Cloudflare R2 ($0 Egress Fees)
# ------------------------------------------------------------------------------
# Set to 'local' for local dev disk storage, 'cloudflare' for R2 in production
ACTIVE_STORAGE_SERVICE=cloudflare
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET=ayoj-media

# ------------------------------------------------------------------------------
# 5. Transactional Emails (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here
MAILER_FROM_EMAIL=notifications@ayoj.in

# ------------------------------------------------------------------------------
# 6. Frontend / CORS Configuration
# ------------------------------------------------------------------------------
FRONTEND_URL=https://ayoj.in
NEXT_PUBLIC_API_URL=/api
